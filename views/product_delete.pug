
extends layout

block content
  h1 Delete Product

  h2= product.name

  p Are you sure you want to delete this product?

  p
    strong Product ID:
    |  #{product._id}

  form(action='/products/delete/' + product._id method='POST')
    div
      label(for='name') Product Name:
      input(type='text' id='name' name='name' value=product.name readonly)

    div
      label(for='price') Price:
      input(type='number' id='price' name='price' value=product.price readonly)

    div
      label(for='category') Category:
      input(type='text' id='category' name='category' value=product.category readonly)

    div
      button(type='submit') Delete Product

  p
    a(href='/products/detail/' + product._id) Cancel
