
extends layout

block content
  h1 Update Product

  h2= product.name

  form(action='/products/update/' + product._id method='POST')
    div
      label(for='name') Product Name:
      input(type='text' id='name' name='name' value=product.name required)

    div
      label(for='price') Price:
      input(type='number' id='price' name='price' value=product.price min='0' step='0.01' required)

    div
      label(for='category') Category:
      input(type='text' id='category' name='category' value=product.category required)

    div
      button(type='submit') Update Product

  p
    a(href='/products/detail/' + product._id) Cancel
